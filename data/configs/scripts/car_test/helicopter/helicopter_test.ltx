[logic]
active = heli_move@idle

[heli_move@idle]
path_move = test_helicopter_idle_walk
path_look = test_helicopter_idle_look

max_velocity = 50
combat_ignore_cond = false
combat_ignore_keep_when_attacked = false

combat_use_rocket = true
combat_use_mgun = true

engine_sound = true
mute = false
engine_sound = true
on_info = {=actor_in_zone(ixray_test_space_restrictor)} heli_move@attack

allow_hit_enemy = true   ;Включение боевого режима при атаке противника 
forget_on_reset = true	 ;Забывать ли противника при смене схемы
forget_on_reload = true  ;Забывать ли противника при установке схемы

[heli_move@attack]
path_move = test_helicopter_move_1_walk
path_look = test_helicopter_move_1_look
engine_sound = true
combat_use_rocket = false
combat_use_mgun = true
mute = false
combat_velocity = 30
max_velocity = 50
combat_safe_alitude = 0
on_info = %=send_tip(SCHEME_2)%
on_info2 = {+helicopter_test} heli_move@idle %-helicopter_test%

forget_hit_enemy = true  ;Разрешить забывать атакующего противника
allow_hit_enemy = true   ;Включение боевого режима при атаке противника 
forget_on_reset = true	 ;Забывать ли противника при смене схемы
forget_on_reload = true  ;Забывать ли противника при установке схемы

[heli_move@back]
path_move = helicopter_idle_walk
path_look = helicopter_idle_look
max_velocity = 50
mute = false
combat_ignore_cond = false
combat_ignore_keep_when_attacked = false
engine_sound = true







