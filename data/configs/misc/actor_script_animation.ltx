;------------Animations-------------------;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;Set Idle

;Сидит полубоком (sit_knee)
[sit_1_animation]
ui_name = st_sit_1_animation

start_animation = idle_0_to_sit_1
stop_animation = sit_1_lazy_idle_0
idle_animation = sit_1_idle_0, sit_1_idle_1, sit_1_idle_2, sit_1_idle_3
start_action = {=no_active_animation} start, fail
stop_action = stop
; animation_parts = legs, torso

idle_animation_can_skip = true

;Сидит на корточках (sit)
[sit_2_animation]
ui_name = st_sit_2_animation

start_animation = idle_0_to_sit_0
stop_animation = sit_0_lazy_idle_0
idle_animation = sit_0_idle_0, sit_0_idle_1, sit_0_idle_2, sit_0_idle_3
start_action = {=no_active_animation} start, fail
stop_action = stop
; animation_parts = legs, torso

idle_animation_can_skip = true

;Сидит на заднице (sit_ass)
[sit_3_animation]
ui_name = st_sit_3_animation

start_animation = idle_0_to_sit_2
stop_animation = sit_2_lazy_idle_0
idle_animation = sit_2_idle_0, sit_2_idle_1, sit_2_idle_2, sit_2_idle_3
start_action = {=no_active_animation} start, fail
stop_action = stop
; animation_parts = legs, torso

idle_animation_can_skip = true

;Спит
[sleeping_1_animation]
ui_name = st_sleeping_1_animation

start_animation = idle_0_to_sit_0, sit_to_sleep_0
stop_animation = sleep_to_sit_0, sit_0_to_idle_0
idle_animation = sleep_idle_0
start_action = {=no_active_animation} start, fail
stop_action = stop

;Занять позу охраника
[ohrana_1_animation]
ui_name = st_ohrana_1_animation

start_animation = ohrana_0
idle_animation = ohrana_1, ohrana_2

start_action = {=no_active_animation} start, fail
stop_action = stop

idle_animation_can_skip = true

;Занять позу командира
[komandir_1_animation]
ui_name = st_komandir_1_animation

start_animation = komandir_0
idle_animation = komandir_1, komandir_2

start_action = {=no_active_animation} start, fail
stop_action = stop

idle_animation_can_skip = true

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;Set Other

;Игра на гитаре
[guitar_play_animation]
ui_name = st_guitar_play_animation

start_animation = sit_1_guitar_0_0, sit_1_guitar_0_1
start_animation_sound = $silent

stop_animation = guitar_0_sit_1_0, guitar_0_sit_1_1
stop_animation_sound = $silent

idle_animation = guitar_0
idle_animation_sound = $silent, characters_voice\human_03\stalker\music\guitar_1, characters_voice\human_03\stalker\music\guitar_2, characters_voice\human_03\stalker\music\guitar_3, characters_voice\human_03\stalker\music\guitar_4, characters_voice\human_03\stalker\music\guitar_5, characters_voice\human_03\stalker\music\guitar_6, characters_voice\human_03\stalker\music\guitar_7, characters_voice\human_03\stalker\music\guitar_8, characters_voice\human_03\stalker\music\guitar_9, characters_voice\human_03\stalker\music\guitar_10, characters_voice\human_03\stalker\music\guitar_11, characters_voice\human_03\stalker\music\guitar_12, characters_voice\human_03\stalker\music\guitar_13, characters_voice\human_03\stalker\music\guitar_14, characters_voice\human_03\stalker\music\guitar_15, characters_voice\human_03\stalker\music\guitar_16

; animation_parts = legs, torso

attachable_items = guitar_a
attach_animation = sit_1_guitar_0_1
dettach_animation = guitar_0_sit_1_1

start_action = {=mp_actor_has_item(guitar_a) =active_animation(sit_1_animation)} start, fail
stop_action = stop ;%=play_next_animation(sit_1_animation)%

[harmonica_play_animation]
ui_name = st_harmonica_play_animation

start_animation = sit_2_harmonica_1_0, sit_2_harmonica_1_1
start_animation_sound = $silent

stop_animation = harmonica_1_sit_2_0, harmonica_1_sit_2_1
stop_animation_sound = $silent

idle_animation = harmonica_0
idle_animation_sound = $silent, characters_voice\human_03\stalker\music\harmonica_1, characters_voice\human_03\stalker\music\harmonica_2, characters_voice\human_03\stalker\music\harmonica_3, characters_voice\human_03\stalker\music\harmonica_4, characters_voice\human_03\stalker\music\harmonica_5

; animation_parts = legs, torso

attachable_items = harmonica_a
attach_animation = sit_2_harmonica_1_1
dettach_animation = harmonica_1_sit_2_1

start_action = {=mp_actor_has_item(harmonica_a) =active_animation(sit_3_animation)} start, fail
stop_action = stop ;%=play_next_animation(sit_2_animation)%


