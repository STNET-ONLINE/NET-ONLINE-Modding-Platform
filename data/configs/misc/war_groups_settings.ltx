#include "war_groups_jupiter_stnet.ltx"

[war_groups_settings]
enable_war_groups = true ;Разрешить войну группировок
enable_fast_travel = true ;Разрешить ли быстрое перемещение
time_capture_centrical = 100 ;Время, требуемое на захват ключевых точек по умолчанию
time_capture_resource = 120; Время, требуемое на захват ресурсных точек по умолчанию
time_capture_reward = 3600; Начислять деньги один раз за это время за удержание ресурсных точек по умолчанию
capture_factor = 0.97 ;Процент уменьшения времени, если точку захватывает несколько людей