jupiter_moskvich_yellow

[jupiter_kamaz_red]
section = veh_kamaz5320_red
random_attachment = kamaz_wheel, kamaz_wheel, kamaz_wheel2, kamaz_wheel2, kamaz_wheel2, kamaz_wheel2, radiator, accumulator, spark_plug, kamaz_front_bamper, kamaz_door_left_red, kamaz_door_right_red
