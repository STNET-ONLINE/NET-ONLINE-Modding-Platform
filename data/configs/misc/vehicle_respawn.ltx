#include "vehicle_level_respawn.ltx"

;В секцию группы машины (Например [car_location_respawn] и [truck_location_respawn])
;Формат заполнения следующий:
;section = veh_niva_white - Секция машины
;random_attachment = test1, test2, test3, test4 - Какие аттачи рандомить
;probability_attachment = 0.5 - Шанс рандома атача (1 = 100%) 
;max_vehicle = 1 - Максимальное число, доступное для респавна этой группы
;max_vehicle_in_level = 10 - Максимально допустимое число машин на уровне (Если машин больше - будут удаляться сначала из респавна, а затем те что принадлежат игрокам)
;unique_id = escape_niva_white - Уникальный ID секции, если нужно больше машин этой группы

[truck_jupiter_respawn]
jupiter_kamaz_red
jupiter_kamaz_white

[niva_jupiter_respawn]
jupiter_niva_white
jupiter_niva_blue
jupiter_niva_green
jupiter_niva_yellow
jupiter_niva_army

[moskvich_jupiter_respawn]
