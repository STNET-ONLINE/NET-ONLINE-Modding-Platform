anm_add_cartridge_empty_preloaded	= spas12_holster 	;указывать аналогично обычному anm_add_cartridge_preloaded, затычка от потенциального вылета

lock_time_start_anm_add_cartridge = 0.2		;аналогично параметрам у open
lock_time_end_anm_add_cartridge = 0.2
lock_time_start_anm_add_cartridge_empty	 = 0.2		;аналогично параметрам у open
lock_time_end_anm_add_cartridge_empty	 = 0.2
lock_time_start_anm_add_cartridge_preloaded	 = 0.2		
lock_time_end_anm_add_cartridge_preloaded	 = 0.2


;конец релоада
anm_close			= spas12_reload_end
anm_close_empty			= spas12_reload_end	;бесполезен, когда add_cartridge_in_open=true; иначе играется, если мы вдруг передумали заряжать пустое ружье, не зарядив ни одного патрона туда
anm_close_preloaded		= spas12_draw
anm_close_empty_preloaded	= spas12_holster 	;указывать аналогично обычному anm_close_preloaded, затычка от потенциального вылета при выбрасывании во время релоада всех патронов на землю


