anm_open_empty			= spas12_draw

add_cartridge_in_open = true	;Говорим, что open содержит в себе добавление в магазин патрона
empty_preload_mode = true	;после анимы anm_open_empty надо играть add_cartridge_preloaded или close_preloaded (т.к. в anm_open_empty загоняется патрон в патронник)

lock_time_start_anm_open = 0.3	;время от старта анимации до зарядки (обновления счетчика) патрона  (если патрон заряжается в open, иначе ставить просто один параметр lock_time_anm_open)
lock_time_end_anm_open = 0.01	;время от момента зарядки патрона (обновления счетчика) до момента, когда можно прерывать аниму
				;если lock_time_start + lock_time_end превышают время проигрывания анимации, то прервать выстрелом набивание магазина будет невозможно! Целесообразно устанавливать время суммарного лока так, чтобы оно было на не менее 100мс меньше времени анимы, чтобы апдейт на остановку стрельбы успел пройти
lock_time_start_anm_open_empty = 0.9	
lock_time_end_anm_open_empty = 0.01	


;добавление патрона
anm_add_cartridge			= spas12_reload
